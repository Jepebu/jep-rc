export HORIZON_DIR="$HOME/horizon"

###################################
### Horizon development aliases ###
###################################

# Starts the Horizon SQL server in an interactive prompt
alias run-sql="LAST_CWD=$(pwd); cd $HORIZON_DIR/packages/horizon-database && pnpm run postgres-local:up; cd \"$LAST_CWD\""

# Connects to the running Horizon SQL database
alias conn-sql='docker exec -it horizon-postgres psql -U postgres -d horizon'

# Restarts the SQL server
alias restart-sql="cd $HORIZON_DIR/packages/horizon-database && pnpm postgres-all:down && pnpm postgres-local:up-detached"

