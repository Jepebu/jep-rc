# 1. Load required modules
autoload -Uz vcs_info
autoload -Uz add-zsh-hook

# 2. Enable dynamic prompt evaluation (CRITICAL)
setopt PROMPT_SUBST

# 3. Configure vcs_info settings
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr "staged"
zstyle ':vcs_info:git:*' unstagedstr "unstaged"
zstyle ':vcs_info:git*+set-message:*' hooks git-color
zstyle ':vcs_info:git:*' formats '[%b]'
zstyle ':vcs_info:git:*' actionformats '[%b|%F{magenta}%a%f]'

# 4. Define the styling and tracking hook
+vi-git-color() {
    local bname=${hook_com[branch]}

    if [[ "$bname" = "main" ]] || [[ "$bname" = "master" ]]; then
        local color="%F{magenta}" # Default magenta for main branch
    else
        local color="%F{green}" # Default green otherwise
    fi

    # Check dirtiness
    if [[ -n ${hook_com[unstaged]} ]]; then
        color="%F{red}"
    elif [[ -n ${hook_com[staged]} ]]; then
        color="%F{yellow}"
    elif [[ -n $(git ls-files --other --exclude-standard 2> /dev/null) ]]; then
        color="%F{cyan}"
    fi

    # Check tracking stats
    local arrows=""
    local tracking_stats=($(git rev-list --left-right --count HEAD...@{u} 2>/dev/null))
    if (( ${#tracking_stats[@]} == 2 )); then
        local ahead=${tracking_stats[1]}
        local behind=${tracking_stats[2]}

        (( ahead > 0 )) && arrows+="↑${ahead}"
        (( behind > 0 )) && arrows+="↓${behind}"
        [[ -n $arrows ]] && arrows=" %F{magenta}${arrows}%f"
    fi

    # Assemble the branch string
    hook_com[branch]="${color}${bname}%f${arrows}"
}

# 5. Register the precmd hook
add-zsh-hook precmd vcs_info

# 6. Idempotent injection into PROMPT
# If the Git variable isn't already in the prompt, prepend it safely
if [[ "$PROMPT" != *'vcs_info_msg_0_'* ]]; then
    # We use single quotes to lock in the variable name, and $'\n' to inject a hard line break
    PROMPT='${vcs_info_msg_0_:+${vcs_info_msg_0_}'$'\n''}'$PROMPT
fi
